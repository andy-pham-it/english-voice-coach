# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — pooled connection, used at runtime (host contains "-pooler")
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres — direct connection, used by drizzle-kit for DDL
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# Gemini — Live API (conversation) and fallback text provider
GEMINI_API_KEY=

# Groq — primary post-session extraction provider
GROQ_API_KEY=

# Single-user access code. Leave unset in local dev to disable auth.
ACCESS_CODE=
# HMAC secret for the session cookie. Generate: openssl rand -hex 32
AUTH_SECRET=

# Shared key for POST /api/spike-log (spike writes test runs into Neon).
# If unset, the endpoint is disabled in production.
SPIKE_LOG_KEY=
